DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Solana — order hash anchors (Memo program). Devnet is fine for the hackathon.
# Generate with: npm run solana:wallet && npm run solana:airdrop
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# SOLANA_RPC_URL=https://YOUR-ENDPOINT.quiknode.pro/TOKEN/
SOLANA_SECRET_KEY=

# Hackathon partner phone (E.164) — OwnerRadar dials this
OWNER_PHONE=+1XXXXXXXXXX

# Retell outbound (preferred)
RETELL_API_KEY=
RETELL_FROM_NUMBER=+1XXXXXXXXXX
RETELL_OWNER_AGENT_ID=

# Or ElevenLabs Twilio outbound
ELEVENLABS_API_KEY=
ELEVENLABS_OWNER_AGENT_ID=
ELEVENLABS_OWNER_PHONE_NUMBER_ID=
