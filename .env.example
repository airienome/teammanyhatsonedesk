DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Solana — order hash anchors. No QuickNode sandbox required.
# Public RPC works. Without free SOL, hashes are ed25519-signed locally
# and auto-upgrade to on-chain memo txs once the wallet is funded.
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_SECRET_KEY=
# Optional later: QuickNode / Helius RPC if you want one
# SOLANA_RPC_URL=https://YOUR-ENDPOINT.quiknode.pro/TOKEN/

# Hackathon partner phone (E.164) — OwnerRadar dials this
OWNER_PHONE=+1XXXXXXXXXX

# Retell outbound (preferred)
RETELL_API_KEY=
RETELL_FROM_NUMBER=+1XXXXXXXXXX
RETELL_OWNER_AGENT_ID=

# Or ElevenLabs Twilio outbound
ELEVENLABS_API_KEY=
ELEVENLABS_OWNER_AGENT_ID=
ELEVENLABS_OWNER_PHONE_NUMBER_ID=
