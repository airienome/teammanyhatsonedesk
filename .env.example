DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Solana — order hash anchors (optional QuickNode RPC)
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_SECRET_KEY=

# Hackathon partner phone (E.164) — SPC alerts SMS here; CALL dials here
OWNER_PHONE=+1XXXXXXXXXX

# Twilio SMS — SPC ≥2σ → text; inbound webhook POST /api/sms
# Twilio console → Phone Number → Messaging webhook: https://YOUR_HOST/api/sms
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# Retell outbound voice (only when owner replies CALL)
RETELL_API_KEY=
RETELL_FROM_NUMBER=+1XXXXXXXXXX
RETELL_OWNER_AGENT_ID=

# Or ElevenLabs Twilio outbound (CALL path)
ELEVENLABS_API_KEY=
ELEVENLABS_OWNER_AGENT_ID=
ELEVENLABS_OWNER_PHONE_NUMBER_ID=
ELEVENLABS_MIA_AGENT_ID=
OWNERRADAR_HOST=https://owneradar.com

# Outbound owner voice dials (default off). Set true to re-enable.
OWNER_CALLS_ENABLED=false
